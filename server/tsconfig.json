{
    "compilerOptions": {
      "target": "ES2024",
      "lib": ["ES2024"],
      "module": "NodeNext",
      "types": ["node"],
      "rootDir": "./src",
      "outDir": "./dist",
      "strict": true,
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true,
      "useDefineForClassFields": false,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "sourceMap": true
    },
    "include": ["src/**/*"]
  }